<https://astrea.linkeddata.es/shapes#6193881395e69fade1e99955e933276c>
        a               sh:PropertyShape ;
        rdfs:label      "a assigné le type de propriété"@fr , "assigned property of type"@en , "This property associates an instance of E13 Attribute Assignment with the type of property or relation that this assignment maintains to hold between the item to which it assigns an attribute and the attribute itself. Note that the properties defined by the CIDOC CRM also constitute instances of E55 Type themselves. The direction of the assigned property of type is understood to be from the attributed item (the range of property P140 assigned attribute to) to the attribute item (the range of the property P141 assigned). More than one property type may be assigned to hold between two items.\nA comprehensive explanation about refining CIDOC CRM concepts by E55 Type is given in the section “About Types” in the section on “Specific Modelling Constructs” of this document."@en ;
        sh:class        cidoc-crm:E55_Type ;
        sh:description  "This property associates an instance of E13 Attribute Assignment with the type of property or relation that this assignment maintains to hold between the item to which it assigns an attribute and the attribute itself. Note that the properties defined by the CIDOC CRM also constitute instances of E55 Type themselves. The direction of the assigned property of type is understood to be from the attributed item (the range of property P140 assigned attribute to) to the attribute item (the range of the property P141 assigned). More than one property type may be assigned to hold between two items.\nA comprehensive explanation about refining CIDOC CRM concepts by E55 Type is given in the section “About Types” in the section on “Specific Modelling Constructs” of this document."@en ;
        sh:name         "assigned property of type"@en , "a assigné le type de propriété"@fr ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:path         cidoc-crm:P177_assigned_property_of_type .

