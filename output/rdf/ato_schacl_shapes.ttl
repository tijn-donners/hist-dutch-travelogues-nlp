<https://astrea.linkeddata.es/shapes#1c76822e0f4726b0cda9fb0cba4d7611>
        a               sh:NodeShape ;
        rdfs:label      "Nascimento"@pt , "Geburt"@de , "出生"@zh , "Рождение"@ru , "Naissance"@fr , "Birth"@en , "Γέννηση"@el ;
        sh:description  "This class comprises the births of human beings. E67 Birth is a biological event focussing on the context of people coming into life. (E63 Beginning of Existence comprises the coming into life of any living being.)\nTwins, triplets, etc. are brought into life by the same instance of E67 Birth. The introduction of the E67 Birth event as a documentation element allows the description of a range of family relationships in a simple model. Suitable extensions may describe more details and the complexity of motherhood since the advent of modern medicine. In this model, the biological father is not seen as a necessary participant in the E67 Birth."@en ;
        sh:name         "Рождение"@ru , "Nascimento"@pt , "Birth"@en , "Γέννηση"@el , "Naissance"@fr , "Geburt"@de , "出生"@zh ;
        sh:nodeKind     sh:IRI ;
        sh:property     <https://astrea.linkeddata.es/shapes#beede928818439bfefd19d84aaaf70ea> , <https://astrea.linkeddata.es/shapes#aab76f1074ee2d2e814099f8206d024a> , <https://astrea.linkeddata.es/shapes#1be50b20b8463cd3aa5dec94f034fcee> ;
        sh:targetClass  cidoc-crm:E67_Birth .

<https://astrea.linkeddata.es/shapes#2f302bd6977d174eabb9e015a7fa58a4>
        a               sh:PropertyShape ;
        rdfs:label      "αναίρεσε"@el , "beendete die Existenz von"@de , "took out of existence"@en , "This property links an instance of E64 End of Existence to the instance of E77 Persistent Item taken out of existence by it.\nIn the case of immaterial things, the instance of E64 End of Existence is considered to take place with the destruction of the last physical carrier.\nThis allows an “end” to be attached to any instance of E77 Persistent Item being documented i.e. instances of E70 Thing, E72 Legal Object, E39 Actor, E41 Appellation, and E55 Type. For many instances of E77 Persistent Item we know the maximum life-span and can infer that they must have ended to exist. We assume in that case an instance of E64 End of Existence, which may be as unnoticeable as forgetting the secret knowledge by the last representative of some indigenous nation."@en , "cessou a existência de"@pt , "a mis fin à l’existence de"@fr , "положил конец существованию"@ru , "结束存在的是"@zh ;
        sh:class        cidoc-crm:E77_Persistent_Item ;
        sh:description  "This property links an instance of E64 End of Existence to the instance of E77 Persistent Item taken out of existence by it.\nIn the case of immaterial things, the instance of E64 End of Existence is considered to take place with the destruction of the last physical carrier.\nThis allows an “end” to be attached to any instance of E77 Persistent Item being documented i.e. instances of E70 Thing, E72 Legal Object, E39 Actor, E41 Appellation, and E55 Type. For many instances of E77 Persistent Item we know the maximum life-span and can infer that they must have ended to exist. We assume in that case an instance of E64 End of Existence, which may be as unnoticeable as forgetting the secret knowledge by the last representative of some indigenous nation."@en ;
        sh:name         "a mis fin à l’existence de"@fr , "cessou a existência de"@pt , "结束存在的是"@zh , "took out of existence"@en , "положил конец существованию"@ru , "αναίρεσε"@el , "beendete die Existenz von"@de ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:path         cidoc-crm:P93_took_out_of_existence .

<https://astrea.linkeddata.es/shapes#2e65209b4e62159425fa4ce09f19f3c3>
        a               sh:PropertyShape ;
        rdfs:label      "R7 exemplifies"@en , "Quantification: many to one, necessary (1,1:0,n)\n\nScope note:\nThis property associates an instance of F3 Manifestation with an instance of F5 Item that is one of its exemplars or its only exemplar.\nInstances of F5 Item correspond to the kinds of physical unit(s) specified in the manifestation, regardless of possible later changes.\nEven though an item may exhibit defects with respect to the intended manifestation, it is still regarded to carry the manifestation, as long as it is produced or made accessible as a functional item by its creators.\n\nExamples:\n- The item held by the Deichman public library in Oslo, identified by inventory number ‘9138513’ (F5) exemplifies the publication ‘Murder on the Orient Express / Agatha Christie’, HarperCollins 2017 (F3).\n- The item held by the National Library of France and identified by shelf mark ‘Res 8 P 10’ (F5) exemplifies the edition of Amerigo Vespucci’s textual and cartographic work entitled ‘Mundus novus’ issued in Paris ca. 1503-1504 (F3).\n"@en ;
        sh:class        lrmoo:F3_Manifestation ;
        sh:description  "Quantification: many to one, necessary (1,1:0,n)\n\nScope note:\nThis property associates an instance of F3 Manifestation with an instance of F5 Item that is one of its exemplars or its only exemplar.\nInstances of F5 Item correspond to the kinds of physical unit(s) specified in the manifestation, regardless of possible later changes.\nEven though an item may exhibit defects with respect to the intended manifestation, it is still regarded to carry the manifestation, as long as it is produced or made accessible as a functional item by its creators.\n\nExamples:\n- The item held by the Deichman public library in Oslo, identified by inventory number ‘9138513’ (F5) exemplifies the publication ‘Murder on the Orient Express / Agatha Christie’, HarperCollins 2017 (F3).\n- The item held by the National Library of France and identified by shelf mark ‘Res 8 P 10’ (F5) exemplifies the edition of Amerigo Vespucci’s textual and cartographic work entitled ‘Mundus novus’ issued in Paris ca. 1503-1504 (F3).\n"@en ;
        sh:name         "R7 exemplifies"@en ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:path         lrmoo:R7_exemplifies .

