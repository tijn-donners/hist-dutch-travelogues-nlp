<https://astrea.linkeddata.es/shapes#db7052fe9b1bac80460b11aa3de61582>
        a               sh:NodeShape ;
        rdfs:label      "Objeto Conceitual"@pt , "Objet conceptuel"@fr , "Концептуальный Объект"@ru , "Νοητικό Αντικείμενο"@el , "概念对象"@zh , "Begrifflicher Gegenstand"@de , "Conceptual Object"@en ;
        sh:description  "This class comprises non-material products of our minds and other human produced data that have become objects of a discourse about their identity, circumstances of creation, or historical implication. The production of such information might have been supported by the use of technical devices such as cameras or computers.\nCharacteristically, instances of this class are created, invented or thought by someone, and then may be documented or communicated between persons. Instances of E28 Conceptual Object have the ability to exist on more than one particular carrier at the same time, such as paper, electronic signals, marks, audio media, paintings, photos, human memories, etc.\nThey cannot be destroyed. They exist as long as they can be found on at least one carrier or in at least one human memory. Their existence ends when the last carrier and the last memory are lost."@en ;
        sh:name         "Objet conceptuel"@fr , "Νοητικό Αντικείμενο"@el , "Begrifflicher Gegenstand"@de , "Objeto Conceitual"@pt , "Концептуальный Объект"@ru , "概念对象"@zh , "Conceptual Object"@en ;
        sh:nodeKind     sh:IRI ;
        sh:property     <https://astrea.linkeddata.es/shapes#89c323e7195b2a699748b8b2a1167c4a> , <https://astrea.linkeddata.es/shapes#9a255169cdbf1bc0eb0b8e44973f8880> ;
        sh:targetClass  cidoc-crm:E28_Conceptual_Object .

