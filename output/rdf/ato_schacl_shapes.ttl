<https://astrea.linkeddata.es/shapes#beede928818439bfefd19d84aaaf70ea>
        a               sh:PropertyShape ;
        rdfs:label      "от отца"@ru , "from father"@en , "gab Vaterschaft"@de , "pelo pai"@pt , "This property links an instance of E67 Birth to an instance of E21 Person in the role of biological father.\nNote that biological fathers are not seen as necessary participants in the birth, whereas birth-giving mothers are (see P96 by mother (gave birth)). The Person being born is linked to the Birth with the property P98 brought into life (was born).\nThis is not intended for use with general natural history material, only people. There is no explicit method for modelling conception and gestation except by using extensions.\nAn instance of E67 Birth is normally (but not always) associated with one biological father."@en , "είχε πατέρα"@el , "de père"@fr , "来自父亲"@zh ;
        sh:class        cidoc-crm:E21_Person ;
        sh:description  "This property links an instance of E67 Birth to an instance of E21 Person in the role of biological father.\nNote that biological fathers are not seen as necessary participants in the birth, whereas birth-giving mothers are (see P96 by mother (gave birth)). The Person being born is linked to the Birth with the property P98 brought into life (was born).\nThis is not intended for use with general natural history material, only people. There is no explicit method for modelling conception and gestation except by using extensions.\nAn instance of E67 Birth is normally (but not always) associated with one biological father."@en ;
        sh:name         "de père"@fr , "είχε πατέρα"@el , "gab Vaterschaft"@de , "来自父亲"@zh , "pelo pai"@pt , "от отца"@ru , "from father"@en ;
