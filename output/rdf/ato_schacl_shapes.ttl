<https://astrea.linkeddata.es/shapes#dbfd90119276c9306b9126cb907eeeb8>
        a               sh:PropertyShape ;
        rdfs:label      "a assigné"@fr , "απέδωσε ως ιδιότητα"@el , "This property records the type that was assigned to an entity by an E17 Type Assignment activity.\nType assignment events allow a more detailed path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned, to E55 Type for assigning types to objects compared to the shortcut offered by P2 has type (is type of).\nFor example, a fragment of an antique vessel could be assigned the type “attic red figured belly handled amphora” by expert A. The same fragment could be assigned the type “shoulder handled amphora” by expert B.\nA Type may be intellectually constructed independent from assigning an instance of it."@en , "atribuiu"@pt , "分配类型"@zh , "assigned"@en , "назначил"@ru , "wies zu"@de ;
        sh:class        cidoc-crm:E55_Type ;
        sh:description  "This property records the type that was assigned to an entity by an E17 Type Assignment activity.\nType assignment events allow a more detailed path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned, to E55 Type for assigning types to objects compared to the shortcut offered by P2 has type (is type of).\nFor example, a fragment of an antique vessel could be assigned the type “attic red figured belly handled amphora” by expert A. The same fragment could be assigned the type “shoulder handled amphora” by expert B.\nA Type may be intellectually constructed independent from assigning an instance of it."@en ;
        sh:name         "a assigné"@fr , "назначил"@ru , "wies zu"@de , "atribuiu"@pt , "απέδωσε ως ιδιότητα"@el , "assigned"@en , "分配类型"@zh ;
