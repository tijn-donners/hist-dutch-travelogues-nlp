        a               sh:PropertyShape ;
        rdfs:label      "borders with"@en , "συνορεύει με"@el , "This symmetric property associates an instance of E53 Place with another instance of E53 Place which shares a part of its border.\nThis property is purely spatial. It does not imply that the phenomena that define, by their extent, places related by P122 borders with have ever shared a respective border at the same time or even coexisted. In particular, this may be the case when the respective common border is formed by a natural feature.\nThis property is not transitive. This property is symmetric."@en , "grenzt an"@de , "est limitrophe de"@fr , "граничит с"@ru , "fronteira com"@pt , "接壤于"@zh ;
        sh:class        cidoc-crm:E53_Place ;
