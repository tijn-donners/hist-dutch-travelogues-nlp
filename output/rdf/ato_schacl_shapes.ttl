<https://astrea.linkeddata.es/shapes#d31363ae2d33a33767220cb3a37cbb32>
        a               sh:NodeShape ;
        rdfs:label      "Κατάσταση"@el , "条件状态"@zh , "Состояние"@ru , "Condition State"@en , "Zustandsphase"@de , "État matériel"@fr , "Estado Material"@pt ;
        sh:description  "This class comprises the states of objects characterised by a certain condition over a time-span.\nAn instance of this class describes the prevailing physical condition of any material object or feature during a specific instance of E52 Time-Span. In general, the time-span for which a certain condition can be asserted may be shorter than the real time-span, for which this condition held.\nThe nature of that condition can be described using P2 has type. For example, the instance of E3 Condition State “condition of the SS Great Britain between 22-nd September 1846 and 27-th August 1847” can be characterized as an instance “wrecked” of E55 Type."@en ;
        sh:name         "Состояние"@ru , "Zustandsphase"@de , "条件状态"@zh , "Estado Material"@pt , "État matériel"@fr , "Condition State"@en , "Κατάσταση"@el ;
