<https://astrea.linkeddata.es/shapes#89d4a83ff45a9d1358b6cba40acde07a>
        a               sh:NodeShape ;
        rdfs:label      "Daseinsende"@de , "Конец Существования"@ru , "End of Existence"@en , "Fin d’existence"@fr , "Τέλος Ύπαρξης"@el , "Fim da Existência"@pt , "结束"@zh ;
        sh:description  "This class comprises events that end the existence of any instance of E77 Persistent Item.\nIt may be used for temporal reasoning about things (physical items, groups of people, living beings) ceasing to exist; it serves as a hook both a terminus post quem and a terminus ante quem. In cases where substance from an instance of E77 Persistent Item continues to exist in a new form, the process would be documented as instances of E81 Transformation."@en ;
        sh:name         "Конец Существования"@ru , "End of Existence"@en , "Fim da Existência"@pt , "Daseinsende"@de , "Τέλος Ύπαρξης"@el , "Fin d’existence"@fr , "结束"@zh ;
