<https://astrea.linkeddata.es/shapes#c92883317f2ce71b1cc8c2f216268cea>
        a               sh:NodeShape ;
        rdfs:label      "Type Creation"@en , "Création de type"@fr , "Criação de Tipo"@pt , "Typuserfindung"@de , "类型创建"@zh , "Δημιουργία Τύπου"@el , "Создание Типа"@ru ;
        sh:description  "This class comprises activities formally defining new types of items.\nIt is typically a rigorous scholarly or scientific process that ensures a type is exhaustively described and appropriately named. In some cases, particularly in archaeology and the life sciences, E83 Type Creation requires the identification of an exemplary specimen and the publication of the type definition in an appropriate scholarly forum. The activity modelled as an instance of E83 Type Creation is central to research in the life sciences, where a type would be referred to as a “taxon,” the type description as a “protologue,” and the exemplary specimens as “original element” or “holotype”."@en ;
        sh:name         "Δημιουργία Τύπου"@el , "Type Creation"@en , "Typuserfindung"@de , "Criação de Tipo"@pt , "Création de type"@fr , "Создание Типа"@ru , "类型创建"@zh ;
        sh:nodeKind     sh:IRI ;
        sh:property     <https://astrea.linkeddata.es/shapes#1018a439e192056b898979a1c34f9f09> , <https://astrea.linkeddata.es/shapes#41184b2fc73c3f98c7317de8e4051fd7> ;
        sh:targetClass  cidoc-crm:E83_Type_Creation .

