<https://astrea.linkeddata.es/shapes#9cbd937f8dd4ab6a7a76aced1b2199ef>
        a               sh:PropertyShape ;
        rdfs:label      "έχει επεξήγηση"@el , "有注释"@zh , "has note"@en , "This property is a container for all informal descriptions about an object that have not been expressed in terms of CIDOC CRM constructs.\nIn particular, it captures the characterisation of the item itself, its internal structures, appearance, etc.\nLike property P2 has type (is type of), this property is a consequence of the restricted focus of the CIDOC CRM. The aim is not to capture, in a structured form, everything that can be said about an item; indeed, the CIDOC CRM formalism is not regarded as sufficient to express everything that can be said. Good practice requires use of distinct note fields for different aspects of a characterisation. The P3.1 has type property of P3 has note allows differentiation of specific notes, e.g. “construction”, “decoration”, etc.\nAn item may have many notes, but a note is attached to a specific item."@en , "имеет примечание"@ru , "tem nota"@pt , "hat Anmerkung"@de , "a pour note"@fr ;
        sh:datatype     rdfs:Literal ;
        sh:description  "This property is a container for all informal descriptions about an object that have not been expressed in terms of CIDOC CRM constructs.\nIn particular, it captures the characterisation of the item itself, its internal structures, appearance, etc.\nLike property P2 has type (is type of), this property is a consequence of the restricted focus of the CIDOC CRM. The aim is not to capture, in a structured form, everything that can be said about an item; indeed, the CIDOC CRM formalism is not regarded as sufficient to express everything that can be said. Good practice requires use of distinct note fields for different aspects of a characterisation. The P3.1 has type property of P3 has note allows differentiation of specific notes, e.g. “construction”, “decoration”, etc.\nAn item may have many notes, but a note is attached to a specific item."@en ;
        sh:name         "has note"@en , "έχει επεξήγηση"@el , "имеет примечание"@ru , "a pour note"@fr , "hat Anmerkung"@de , "有注释"@zh , "tem nota"@pt ;
        sh:nodeKind     sh:Literal ;
        sh:path         cidoc-crm:P3_has_note .

